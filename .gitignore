# Manga & Doujinshi Duplicate Finder - .gitignore

# User data & samples (as specified)
sample_data/
sample_data/*

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment and secrets
.env
.env.local
*.env

# IDE and Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Output and report folders
reports/
output/
logs/
*.log
_duplicates_quarantine/
